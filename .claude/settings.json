{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git remote -v)",
      "Bash(git ls-files:*)",
      "Bash(git ls-remote:*)",
      "Bash(git fetch:*)",
      "Bash(git check-ignore:*)",
      "Bash(shopify theme check:*)",
      "Bash(shopify theme list:*)",
      "Bash(shopify version)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(uv --version)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(shopify theme publish:*)",
      "Bash(shopify theme push:*)"
    ]
  }
}
