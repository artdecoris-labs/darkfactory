# Shopify AI Toolkit Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit the .env file to Git

# ============================================
# Store Configuration
# ============================================

# Your Shopify store URL (e.g., mystore.myshopify.com)
SHOPIFY_STORE_URL=

# Shopify API access token (generate from Admin > Settings > Developer > API Tokens)
# Keep this secret! Use .env only (gitignored)
SHOPIFY_API_TOKEN=

# ============================================
# Theme Configuration
# ============================================

# Path to your local theme repository
THEME_PATH=C:\DevOps\artdecoris-shop-theme-00

# Theme ID from 'shopify theme list' (optional, auto-detected if not set)
THEME_ID=

# ============================================
# Toolkit Behavior
# ============================================

# Disable telemetry reporting (true/false)
OPT_OUT_INSTRUMENTATION=false

# Enable debug logging (true/false)
DEBUG=false

# Log file location (optional)
LOG_FILE=./toolkit.log

# ============================================
# Validation Rules
# ============================================

# Strict theme validation (true/false)
STRICT_VALIDATION=true

# Auto-fix common Liquid errors (true/false)
AUTO_FIX_ERRORS=false

# ============================================
# Search & Documentation
# ============================================

# Primary documentation source (shopify/external/local)
DOCS_SOURCE=shopify

# Include deprecated API docs (true/false)
INCLUDE_DEPRECATED=false

# ============================================
# Store Execution Policy
# ============================================

# Require confirmation before executing store changes (true/false)
REQUIRE_CONFIRMATION=true

# Allowed store operations (comma-separated: create,update,delete)
ALLOWED_OPERATIONS=read,update

# ============================================
# Development Mode
# ============================================

# Enable development mode with extra logging
DEVELOPMENT_MODE=false

# Output directory for generated files
OUTPUT_DIR=./output

# ============================================
# Advanced Configuration
# ============================================

# HTTP proxy (if required by network policy)
HTTP_PROXY=

# HTTPS proxy (if required by network policy)
HTTPS_PROXY=

# Custom skill scripts directory
CUSTOM_SKILLS_DIR=./custom-skills

# ============================================
# Notes
# ============================================
# - All values are optional; defaults are used if not provided
# - Store credentials are required for store operations
# - Use quotes for values with spaces: VALUE="my value"
# - Environment variables override config.json settings
